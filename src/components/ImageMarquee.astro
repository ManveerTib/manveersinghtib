---
/**
 * ImageMarquee: two rows of photos the reader steps through with arrow buttons.
 * No autoplay: the rows only move when someone clicks (or swipes/drag-scrolls).
 *
 * Swap the image URLs below for local files (e.g. /marquee/photo1.jpg in /public)
 * whenever you want to self-host instead of postimg.cc.
 */

const rowOne = [
	"https://i.postimg.cc/c4Q3mwgZ/IMG-0498-(2).jpg",
